/* Cyberpunk theme for Clanker TUI */

Screen {
    background: black;
    color: rgb(200, 200, 200);
}

/* Compact feedback for copies and other informational notifications. */
Toast.-information {
    width: auto;
    max-width: 50%;
    padding: 0 1;
    background: $surface;
    color: $foreground;
    border-left: outer $success;
}

#workspace-shortcuts {
    height: 1;
    color: rgb(140,140,140);
    padding: 0 1;
}

#input-area {
    dock: bottom;
    height: auto;
    border-top: solid rgb(60, 60, 80);
}

/* === Chat Log === */
ChatLog {
    width: 100%;
    height: 1fr;
    overflow-y: scroll;
    border: none;
    padding: 0 1 1 1;
}

ChatLog .msg-user {
    color: rgb(0, 240, 240);
    width: 1fr;
    margin: 0 0 1 0;
}

ChatLog .msg-assistant {
    width: 1fr;
}

ChatLog .msg-card {
    background: transparent;
    padding: 1 1 0 1;
    margin: 0 0 0 0;
}

ChatLog .notify-info {
    border-left: thick rgb(0, 240, 240);
}

ChatLog .notify-success {
    border-left: thick rgb(180, 255, 60);
}

ChatLog .notify-warning {
    border-left: thick rgb(255, 220, 60);
}

ChatLog .notify-error {
    border-left: thick rgb(255, 105, 180);
}

ChatLog .thinking-card {
    background: transparent;
    border-left: solid rgb(180, 140, 255);
    padding: 1 0 1 1;
}

ChatLog .msg-notify {
    width: 1fr;
}

ChatLog .msg-tool {
    width: 1fr;
}

ChatLog .msg-tool-output {
    width: 1fr;
}

ChatLog .tool-card {
    background: transparent;
    border-left: solid rgb(200, 200, 200);
    padding: 1 0 1 1;
}

ChatLog .msg-code {
    width: 1fr;
}

ChatLog .msg-system {
    color: rgb(0, 240, 240);
    width: 1fr;
}

ChatLog .msg-error {
    color: rgb(255, 105, 180);
    width: 1fr;
}

ChatLog .msg-warning {
    color: rgb(255, 220, 60);
    width: 1fr;
}

ChatLog .msg-info {
    color: rgb(0, 240, 240);
    width: 1fr;
}

ChatLog .msg-success {
    color: rgb(180, 255, 60);
    width: 1fr;
}

/* Hero section */
ChatLog #hero-widget {
    width: 1fr;
    margin: 0;
    padding: 0;
}

/* Update-available banner, mounted below the hero */
ChatLog .update-banner {
    background: transparent;
    border: round rgb(180,255,60);
    padding: 1 2;
    margin: 0 0 1 0;
    width: auto;
}

/* HR after hero */
ChatLog > Rule.hero-divider,
ChatLog Rule.hero-divider {
    color: rgb(0, 240, 240);
}

/* Turn separators and line breaks */
ChatLog > Rule.dashed,
ChatLog Rule.dashed {
    color: rgb(60, 60, 80);
}

ChatLog > Rule,
ChatLog Rule {
    color: rgb(60, 60, 80);
}

/* === Status Bar — hidden when empty, auto-shows === */
StatusBar {
    height: auto;
    dock: top;
    background: rgb(15, 15, 15);
    border: none;
    border-bottom: tab rgb(60, 60, 80);
    visibility: hidden;
    margin: 0;
    padding: 0 1;
}

StatusBar.visible {
    visibility: visible;
}
